# ===========================================
# AlphaOne BTC AI - Environment Variables
# ===========================================
# Copy this file to .env and fill in values
# NEVER commit .env to version control

# --- Application ---
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=change-me-to-a-random-string

# --- Database ---
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/alphaone
DATABASE_URL_SYNC=postgresql://user:password@localhost:5432/alphaone

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Exchange (Binance) ---
EXCHANGE_ID=binance
EXCHANGE_API_KEY=your-api-key-here
EXCHANGE_API_SECRET=your-api-secret-here
EXCHANGE_TESTNET=true
EXCHANGE_DEFAULT_MARKET=BTC/USDT:USDT

# --- CoinDCX (Phase 5, read-only account monitoring -- NEVER trading-enabled) ---
COINDCX_API_KEY=your-read-only-api-key-here
COINDCX_API_SECRET=your-api-secret-here

# --- Background scheduler (Phase 5) ---
# Runs account sync / signal generation / exit-alert checks periodically.
# Must run on a persistent process, never inside a serverless function.
SCHEDULER_ENABLED=false

# --- Live market data (public CoinDCX WebSocket, no credentials needed) ---
# Streams a live BTC/USDT price for dashboard display and monitoring
# freshness. Must run on a persistent process, never inside a serverless
# function. Falls back to the existing Binance-candle price when disabled.
MARKET_DATA_WS_ENABLED=false

# --- Telegram ---
TELEGRAM_BOT_TOKEN=your-bot-token-here
TELEGRAM_CHAT_ID=your-chat-id-here
TELEGRAM_ENABLED=false

# --- Telegram: external read-only signal ingestion (Multi-Coin AI Futures
# System) -- see reports/TELEGRAM_SIGNAL_RESEARCH_V1.txt. Requires the
# above bot to be added as an ADMINISTRATOR of the channel below before
# this has any real effect; false by default either way.
TELEGRAM_EXTERNAL_SIGNALS_ENABLED=false
TELEGRAM_EXTERNAL_SIGNAL_CHANNEL=@suncrypto_trading_alerts
TELEGRAM_EXTERNAL_SIGNAL_CHANNEL_ID=

# --- Telegram: MTProto read-only listener (Multi-Coin AI Futures System)
# -- use this path instead of the Bot API above when you do NOT own/
# administer the signal channel. Run services/telegram_mtproto/
# setup_session.py YOURSELF, once, in your own terminal to obtain
# TELEGRAM_SESSION -- never generated by any automated process, never
# committed. See reports/MTPROTO_SIGNAL_INGESTION_V1.txt.
TELEGRAM_MTPROTO_ENABLED=false
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=

# --- ML Model ---
MODEL_PATH=./ml/models
MODEL_VERSION=v1
PREDICTION_THRESHOLD=0.55

# --- Risk Engine ---
RISK_PER_TRADE_PCT=0.5
MAX_DAILY_LOSS_PCT=2.0
MAX_DRAWDOWN_PCT=10.0
MAX_LEVERAGE=5
MAX_POSITIONS=1
MAX_DAILY_TRADES=10

# --- Trading Mode ---
TRADING_MODE=paper
# Options: paper, backtest, testnet, live

# --- Backend API ---
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=http://localhost:3000

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
